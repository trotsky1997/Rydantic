{
  "listen": "127.0.0.1:8989",
  "routes": {
    "responses": [{ "api": "responses", "base_url": "https://api.openai.com/v1", "model": "your-responses-model", "api_key_env": "APIKEY" }],
    "chat": [{ "api": "chat_completions", "base_url": "https://api.openai.com/v1", "model": "your-chat-model", "api_key_env": "APIKEY" }],
    "messages": [{ "api": "anthropic_messages", "base_url": "https://api.anthropic.com/v1", "model": "your-messages-model", "api_key_env": "ANTHROPIC_APIKEY" }]
  },
  "clients": [{ "id": "local", "key_env": "RYDANTIC_GATEWAY_KEY", "models": ["responses", "chat", "messages"] }]
}
