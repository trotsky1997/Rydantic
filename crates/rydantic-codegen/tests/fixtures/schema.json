{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {"label": {"type":"string", "minLength":1, "maxLength":3}},
  "type":"object", "additionalProperties":false,
  "required":["type", "a-b", "a_b", "nullable", "mode", "count", "nested", "quote\"\n\\"],
  "properties": {
    "type":{"$ref":"#/$defs/label"},
    "a-b":{"type":"boolean"},
    "a_b":{"type":"array","minItems":1,"maxItems":2,"items":{"$ref":"#/$defs/label"}},
    "nullable":{"type":["string","null"],"minLength":2},
    "mode":{"type":"string","enum":["type","a-b","a_b","\"\n\\"]},
    "count":{"type":"integer","minimum":-10,"maximum":10},
    "nested":{"type":"object","additionalProperties":false,"required":["flag"],"properties":{"flag":{"type":"boolean"}}},
    "quote\"\n\\":{"type":"null"}
  }
}
