{
  "manifest_version": 1,
  "skill": {
    "name": "rydantic",
    "version": "0.1.0",
    "format": "https://agentskills.io/specification"
  },
  "cli": {
    "package": "rydantic-cli",
    "version": "0.1.0",
    "protocol": "rydantic.cli/v1",
    "protocol_version": 1,
    "knowledge_version": 1,
    "required": false,
    "distribution": "unpublished-source",
    "commands": [
      "capabilities",
      "doctor",
      "explain"
    ]
  },
  "core_tracks": [
    {
      "version": "0.6.0",
      "source": "registry+https://github.com/rust-lang/crates.io-index",
      "derive_version": "0.6.0",
      "reference": "references/stable-0.6.0.md",
      "consumer_manifest": "assets/stable-0.6.0/Cargo.toml",
      "consumer_lock": "assets/stable-0.6.0/Cargo.lock",
      "default_features": [
        "derive"
      ],
      "available_features": [
        "derive",
        "dynamic",
        "chrono",
        "decimal",
        "capnp",
        "axum",
        "sqlx",
        "sqlite",
        "postgres",
        "mysql"
      ],
      "consumer_features": [
        "derive",
        "dynamic"
      ],
      "consumer_toolchain": "1.98.1"
    }
  ],
  "beta_tracks": [],
  "recipes": [
    {
      "id": "stable-contracts",
      "core_version": "0.6.0",
      "manifest": "assets/stable-0.6.0/Cargo.toml",
      "command": [
        "cargo",
        "+1.98.1",
        "test",
        "--manifest-path",
        "assets/stable-0.6.0/Cargo.toml",
        "--frozen"
      ],
      "working_directory": "skill-root",
      "requires_execution_authorization": true,
      "verification": "typed-tests-and-explicit-structural-assertions"
    }
  ]
}
