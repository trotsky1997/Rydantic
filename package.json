{
  "name": "rydantic-web",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "docs:check": "node scripts/check-docs.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:dev": "npm run site:build && python3 -m http.server 4173 --directory .site",
    "check": "node scripts/check-web.mjs && npm run examples:check",
    "examples:sync": "node scripts/sync-examples.mjs",
    "examples:check": "node scripts/sync-examples.mjs --check",
    "docs:test": "node --test scripts/check-docs.test.mjs"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.1",
    "@sindresorhus/slugify": "3.0.1"
  }
}
