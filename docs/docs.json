{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rydantic",
  "description": "Typed data, APIs and AI in Rust. A practical guide to Rydantic and RydanticAI.",
  "colors": {
    "primary": "#17684D",
    "light": "#8CDDB6",
    "dark": "#17684D"
  },
  "favicon": "/assets/favicon.svg",
