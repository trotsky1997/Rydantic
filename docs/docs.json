        "href": "https://docs.rs/rydantic/0.8.0/rydantic/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/trotsky1997/Rydantic"
    }
  },
  "navigation": {
